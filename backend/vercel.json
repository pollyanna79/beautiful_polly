{
  "version": 2,
  "builds": [
    {
      "src": "api.js",
      "use": "@vercel/node"
    },
    {
      "src": "../front-end/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api.js"
    },
    {
      "src": "/(.*)",
      "dest": "../front-end/$1"
    }
  ]
}
